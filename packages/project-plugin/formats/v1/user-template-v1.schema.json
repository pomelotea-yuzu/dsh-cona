{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-cona.dev/schemas/user-template-v1.schema.json",
  "title": "DSH Cona user template record body v1",
  "description": "用户流程模板正文（plan-change，摘要前缀 [cona:template] ）。正文首行必须为 <!-- cona:template v1 -->，紧接一个 json 围栏代码块，代码块内容符合本 schema。只含作者确认的标题、目标、完成条件、层级与内部依赖；使用局部键，节点身份、聊天、授权与私有数据不进入正文。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "templateId", "title", "bodyLanguage", "nodes", "dependencies"],
  "properties": {
    "version": { "const": 1 },
    "templateId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "bodyLanguage": { "type": "string", "pattern": "^(?:[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*|und)$" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "parentKey", "order", "title", "goal", "completionCriteria"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "parentKey": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "order": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "goal": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "completionCriteria": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "maxLength": 500 }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeKey", "requiresKey"],
        "properties": {
          "nodeKey": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "requiresKey": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
        }
      }
    }
  }
}
