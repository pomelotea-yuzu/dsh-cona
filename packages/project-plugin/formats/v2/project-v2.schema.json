{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh-cona:project-v2",
  "title": "DSH-Cona 公开项目资料 v2（project.json）",
  "description": "v2 在 v1 之上增加 plan.roadmap（里程碑与交付引用）。权威校验由插件实现与独立实现按 protocol/plan-canonicalization-v2.md 执行；本 schema 供阅读与辅助校验。v1 资料保持原 schema 与指纹，不补扩展字段。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "plan", "planVersion", "records"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "goal", "constraints", "repositories"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string" },
        "goal": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/uuid" },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "dependencies", "roadmap"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "parentId", "order", "title", "goal", "completionCriteria", "status"],
            "properties": {
              "id": { "$ref": "#/$defs/uuid" },
              "parentId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }] },
              "order": { "$ref": "#/$defs/nonNegativeSafeInteger" },
              "title": { "type": "string" },
              "goal": { "type": "string" },
              "completionCriteria": { "type": "array", "items": { "type": "string" } },
              "status": { "enum": ["todo", "in-progress", "blocked", "done", "canceled"] }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodeId", "requiresNodeId"],
            "properties": {
              "nodeId": { "$ref": "#/$defs/uuid" },
              "requiresNodeId": { "$ref": "#/$defs/uuid" }
            }
          }
        },
        "roadmap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["milestones"],
          "description": "里程碑集合（可为空）。每个节点至多一个里程碑；里程碑不表达执行依赖或完成状态。",
          "properties": {
            "milestones": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["nodeId", "deliveries"],
                "properties": {
                  "nodeId": {
                    "$ref": "#/$defs/uuid",
                    "description": "树中存在的稳定节点；以该节点自身完成条件为准。"
                  },
                  "deliveries": {
                    "type": "array",
                    "description": "交付引用；同一里程碑内 (kind, refId) 不得重复，不得把自身作为交付。",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["kind", "refId"],
                          "properties": {
                            "kind": { "const": "node" },
                            "refId": { "$ref": "#/$defs/uuid" }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["kind", "refId", "contentHash"],
                          "properties": {
                            "kind": { "const": "record" },
                            "refId": { "$ref": "#/$defs/uuid" },
                            "contentHash": { "$ref": "#/$defs/sha256Ref" }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "planVersion": { "$ref": "#/$defs/sha256Ref" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "subjectNodeIds", "path", "contentHash", "summary", "sources"],
        "properties": {
          "id": { "$ref": "#/$defs/uuid" },
          "kind": { "enum": ["plan-change", "analysis-note", "execution-note", "verification"] },
          "subjectNodeIds": { "type": "array", "items": { "$ref": "#/$defs/uuid" } },
          "path": {
            "type": "string",
            "pattern": "^records/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[0-9a-f]{64}\\.md$"
          },
          "contentHash": { "$ref": "#/$defs/sha256Ref" },
          "summary": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/uuid" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["repositoryId", "relativePath"],
                  "properties": {
                    "repositoryId": { "$ref": "#/$defs/uuid" },
                    "relativePath": { "type": "string" },
                    "observedHash": { "$ref": "#/$defs/sha256Ref" }
                  }
                }
              ]
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "subject"],
            "properties": {
              "status": { "enum": ["pass", "fail", "blocked", "untested"] },
              "subject": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "id"],
                "properties": {
                  "kind": { "enum": ["node", "record"] },
                  "id": { "$ref": "#/$defs/uuid" }
                }
              },
              "subjectVersion": { "$ref": "#/$defs/sha256Ref" },
              "scope": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "v4 形态小写 UUID（crypto.randomUUID 输出形态）"
    },
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "sha256Ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
