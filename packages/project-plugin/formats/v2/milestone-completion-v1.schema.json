{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-cona.dev/schemas/milestone-completion-v1.schema.json",
  "title": "DSH Cona milestone completion record body v1",
  "description": "里程碑完成记录正文（verification，摘要前缀 [cona:milestone-completion] ）。正文首行必须为 <!-- cona:milestone-completion v1 -->，紧接一个 json 围栏代码块，代码块内容符合本 schema。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "milestoneNodeId", "inputPlanVersion", "evidence"],
  "properties": {
    "version": { "const": 1 },
    "milestoneNodeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "inputPlanVersion": {
      "description": "完成命令核对的输入规划指纹（sha256:<64 位小写十六进制>）",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence": {
      "description": "按完成条件原顺序逐项列出；criterionIndex 从 0 连续，criterionText 为条件原文",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionIndex", "criterionText", "recordId", "contentHash"],
        "properties": {
          "criterionIndex": { "type": "integer", "minimum": 0 },
          "criterionText": { "type": "string", "minLength": 1 },
          "recordId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
