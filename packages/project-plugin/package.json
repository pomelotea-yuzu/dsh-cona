{
  "name": "dsh-cona-project",
  "version": "0.1.0",
  "private": true,
  "description": "DSH-Cona 项目管理插件（R1）：领域、公开资料格式与无宿主校验",
  "type": "module",
  "engines": {
    "dsh": "0.2.2-rc.2",
    "node": ">=24.9.0"
  },
  "main": "./lib/host/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client/index.js",
    "./cli/validate": "./lib/cli/validate.js",
    "./cli/source": "./lib/cli/source.js",
    "./cli/local": "./lib/cli/local.js",
    "./cli/command": "./lib/cli/command.js",
    "./cli/snapshot": "./lib/cli/snapshot.js",
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "formats",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/generate-typert.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.domain.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:protocol-sync": "node scripts/check-protocol-sync.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "generate:typert": "node scripts/generate-typert.mjs",
    "test": "npm run build && npm run test:run",
    "validate": "node lib/cli/validate.js",
    "source": "node lib/cli/source.js",
    "local": "node lib/cli/local.js",
    "command": "node lib/cli/command.js",
    "snapshot": "node lib/cli/snapshot.js",
    "test:run": "tsc -p tsconfig.test.json && node --test lib-test/test/*.test.js",
    "check:locale": "node scripts/check-locale.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.12",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "4.6.6"
  }
}
